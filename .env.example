# Copy to .env and fill in: cp .env.example .env

# --- Container ---
# Owner of the cloned repositories in ./workspace (run `id -u` / `id -g` on the host)
PUID=1000
PGID=1000
TZ=Europe/Rome

# --- GitHub (required) ---
GITHUB_USER=your_username
# Personal access token with read access to the repositories
GITHUB_TOKEN=ghp_your_token
# Comma-separated list of repositories to clone into ./workspace
GITHUB_REPOS=repo1,repo2
# Secret configured in the GitHub webhook settings (used to verify the HMAC signature)
WEBHOOK_SECRET=change_me

# --- Web interface (optional) ---
# Set both to protect http://localhost:49000/ with Basic Auth
WEB_AUTH_USER=
WEB_AUTH_PASS=

# --- Telegram bot (optional) ---
# Token from @BotFather; leave empty to disable the bot
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (send /myid to get yours).
# Leave empty and the bot is open to anyone!
TELEGRAM_ALLOWED_USERS=

# --- /quick defaults (optional) ---
# Used until a repo/device is picked once; then the bot remembers the last choice
DEFAULT_REPO=
DEFAULT_DEVICE=Amazfit Balance
# Branch that /quick resets to
DEFAULT_BRANCH=main
